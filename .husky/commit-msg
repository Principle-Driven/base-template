export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
  cat >&2 <<'EOF'
The commit message check needs mise, which is not installed.
On macOS, run: bash scripts/setup.sh
On other systems, install mise: https://mise.jdx.dev/getting-started.html
EOF
  exit 1
fi

mise exec -- prosecheck check --semantic off "$1"
